{
  "name": "WeeklyTask",
  "type": "object",
  "properties": {
    "week_start": { "type": "string", "description": "Monday of the week (yyyy-MM-dd)" },
    "project_id": { "type": "string" },
    "project_name": { "type": "string", "description": "Free-text project label (e.g. Others) when there is no Project record" },
    "title": { "type": "string", "description": "Task" },
    "expected_result": { "type": "string", "description": "Target / Expected Result, free text" },
    "estimated_hours": { "type": "number", "minimum": 0, "description": "Total estimated hours for the task (shared between assignees); empty for N/A" },
    "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"], "default": "Medium" },
    "notes": { "type": "string" },
    "sort_order": { "type": "number" },
    "allocated_by": { "type": "string", "description": "User id of the leader who last saved this task" }
  },
  "required": ["week_start", "title"]
}
